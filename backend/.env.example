# Copy to .env and adjust values.

PORT=4000
NODE_ENV=development

# Origins allowed to call this API with credentials (comma-separated
# list is supported). The deployed Render service uses
# https://wakadala-star.github.io (set in render.yaml instead).
CLIENT_ORIGIN=http://localhost:4200

# PostgreSQL connection — either set DATABASE_URL (Neon/Render style,
# takes precedence) or the individual PG* variables for local dev:
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=mukwasi_agri_business

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=7d
COOKIE_NAME=farmis_token
